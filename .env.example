# Copy to .env.local (and add the same keys in your host's environment settings).

# Desktop consultation form → email delivery via https://resend.com
RESEND_API_KEY=
# Inbox(es) that receive consultation requests, comma-separated
LEADS_EMAIL_TO=concierge@applausereality.com
# Optional: sender on a domain verified in Resend (defaults to Resend's test sender)
LEADS_EMAIL_FROM=

# Sanity (photos, videos and brochures). Leave the project ID empty to serve the bundled files in /public.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the Sanity webhook that refreshes the site on publish (POST /api/revalidate)
SANITY_REVALIDATE_SECRET=
